# Common Gitignore for Python / Machine Learning projects

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.idea/
# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/
env.bak/
venv.bak/

# Python environment files
.Python
Pipfile.lock

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# mypy
.mypy_cache/

# pytype
.pytype/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# IDEs and editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# System files
.DS_Store
Thumbs.db
desktop.ini

# Logs and databases
*.log
*.sql
*.sqlite

# Model checkpoints, datasets and large outputs (common in ML projects)
data/
datasets/
raw_data/
processed/
models/
checkpoints/
weights/
logs/
outputs/
results/
predictions/

# Common model file extensions
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.pb
*.onnx
*.tflite

# Numpy / binary data
*.npy
*.npz

# Temporary files
*.swp
*~
# Backup files
*.bak

# Notebook checkpoints and workspace files
.ipynb_checkpoints/
workspace/

# macOS Finder tags
.Spotlight-V100
.Trashes
